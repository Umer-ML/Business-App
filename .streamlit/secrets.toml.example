# Streamlit Secrets Configuration Example
# Rename this file to secrets.toml in .streamlit/ or copy into Streamlit Cloud Secrets settings

# Initial Admin Credentials (defaults to admin / admin123 if omitted)
APP_ADMIN_USER = "admin"
APP_ADMIN_PASSWORD = "your_secure_password_here"

# Backward compatibility password fallback
APP_PASSWORD = "your_secure_password_here"

# Cloud Database URL (Supabase, Neon, Railway, or any PostgreSQL)
# Example: postgresql://postgres.xxxx:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL = "postgresql://username:password@hostname:port/database"
